# ===== Telegram =====
# @BotFather dan olingan token. Bot sozlamalarida "Business Mode" yoqilgan bo'lishi kerak.
BOT_TOKEN=
# Sizning shaxsiy Telegram ID raqamingiz (masalan @userinfobot orqali bilib olasiz).
# Bot faqat shu ID'ga xizmat qiladi.
OWNER_TELEGRAM_ID=

# ===== Supabase =====
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role kaliti FAQAT serverda saqlanadi. Hech qachon frontend yoki repo'ga qo'ymang.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Redis (BullMQ) =====
# Masalan: rediss://default:PASSWORD@HOST:PORT  (Upstash / Render Key Value / Railway Redis)
REDIS_URL=

# ===== AI =====
# claude yoki openai
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OpenAI ishlatilsa, model nomini o'zingiz kiriting (masalan sizning hisobingizda mavjud model)
OPENAI_MODEL=

# ===== Boshqa =====
TIMEZONE=Asia/Tashkent
LOG_LEVEL=info
# Render "Web Service" sifatida ishga tushirilsa health-check uchun port (ixtiyoriy)
PORT=
