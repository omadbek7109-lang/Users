{
  "name": "personal-telegram-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Telegram AI Assistant: Stories (Telegram Business), Group Cleaner, AI Message Editor, Timed Media",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.12.0",
    "grammy": "^1.36.0",
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
